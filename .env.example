# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Encrypt workspace/teams credentials at rest (openssl rand -hex 32)
ENCRYPTION_KEY=your-64-char-hex-key

API_VERSION=1

# Encrypt success API bodies ({ encrypted: true, payload: "..." }) — extension uses same key
ENCRYPT_API_RESPONSES=true

# Set true to enable API console.log / warn / error (lib/logger.js)
DEBUG_LOGGING=false
